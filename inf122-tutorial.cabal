-- The lecturer's weekly sheets: one more component per week, since each
-- week's Oppgaver.hs sits in the same folder as its Exercises.hs. No
-- solutions counterpart -- the sheets have no reference answers.
-- QuickCheck is listed so you can `import Test.QuickCheck` in Oppgaver.hs
-- and write properties next to your answers (docs/checking-your-work.md).
executable week01-oppgaver
  import:         warnings
  hs-source-dirs: tutorial/week01
  main-is:        OppgaverTests.hs
  other-modules:  Oppgaver
  build-depends:  base, inf122-tutorial:check, QuickCheck

