cabal-version:   3.0
name:            inf122-tutorial
version:         0.1.0.0
synopsis:        IDE scaffolding for the INF122 tutorial (not a build system)
build-type:      Simple

-- This file exists ONLY so haskell-language-server can give you types, hover
-- and inline errors in the editor. Nothing in the tutorial builds through
-- cabal: ./check.sh still runs each week with plain runghc, exactly as before,
-- and you never need to run `cabal build` yourself.
--
-- The reason it is needed: every week defines a module called `Exercises`, so
-- they cannot all be loaded at once, and Tests.hs imports `Check` from
-- tutorial/lib. Cabal components express both facts; a loose -i search path
-- cannot. See docs/setup-notes.md.
--
-- Adding a week: copy the `executable`/`library` pair and bump the number.
-- Adding a lecturer's sheet: copy a `weekNN-oppgaver` executable.

common warnings
  ghc-options:      -Wno-x-partial
  default-language: Haskell2010

-- The shared test harness, imported by every week's Tests.hs.
library check
  import:          warnings
  hs-source-dirs:  tutorial/lib
  exposed-modules: Check
  build-depends:   base

-- Your work: one component per week, so the `Exercises` modules stay separate.
executable week01-tests
  import:         warnings
  hs-source-dirs: tutorial/week01
  main-is:        Tests.hs
  other-modules:  Exercises
  build-depends:  base, inf122-tutorial:check

