# GHC / build artifacts
*.hi
*.o
*.dyn_hi
*.dyn_o
*.prof
*.hp
*.aux
dist/
dist-newstyle/
.stack-work/
.ghc.environment.*

# Compiled binaries (no extension) — track sources only
!*.hs
!*.lhs

# Secrets — never commit
.env

# Python tooling for the sync/search scripts
.venv/
__pycache__/
*.pyc

# Generated: extracted text cache for src/find.py
.searchcache/

# Public, re-downloadable material — not this repo's job to version.
# The folder's own README is tracked so the instructions travel with the repo;
# nothing you put beside it is.
reference/*
!reference/README.md
