# Copy to .env and fill in. .env is gitignored — never commit the real token.
#
# Generate a token in Mitt UiB:
#   Account -> Settings -> Approved Integrations -> + New Access Token
#   Purpose: "haskell-class repo sync"
#
# The token is read-only in practice here: canvas_sync.py only issues GETs.
# It never submits an assignment, marks a module done, or changes a setting.
#
# Revoke it from the same Settings page the day the course ends.

CANVAS_BASE_URL=https://mitt.uib.no
CANVAS_COURSE_ID=59171
CANVAS_API_TOKEN=paste_your_token_here
